# ---- Proveedores -------------------------------------------------------------
# mock       → sin red ni claves (recomendado para la demo en clase)
# openrouter → cualquier modelo vía OpenRouter (requiere OPENROUTER_API_KEY)
# anthropic  → Claude API directa (requiere ANTHROPIC_API_KEY o perfil de `ant auth login`)
LLM_PROVIDER=mock
# mock | yfinance
MARKET_DATA_PROVIDER=mock

# ---- OpenRouter (solo si LLM_PROVIDER=openrouter) ----------------------------
# Crea la clave en https://openrouter.ai/keys . NUNCA la subas al repositorio.
OPENROUTER_API_KEY=
# Identificador de modelo de OpenRouter (ver https://openrouter.ai/models)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_TIMEOUT_S=60
# Llamadas LLM simultáneas como máximo (protege límites de tasa)
LLM_MAX_CONCURRENCY=4
# Precios manuales (USD por millón de tokens) para estimar coste si el proveedor no lo informa
# LLM_PRICE_INPUT_PER_MTOK=3
# LLM_PRICE_OUTPUT_PER_MTOK=15

# ---- Anthropic (solo si LLM_PROVIDER=anthropic) ------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (bajo es suficiente: el LLM solo redacta resúmenes)
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_TIMEOUT_S=60
# Fallback en servidor si el modelo rechaza una petición (solo Claude API directa)
ANTHROPIC_ENABLE_FALLBACKS=true

# ---- Ejecución ---------------------------------------------------------------
MAX_SYMBOLS_PER_RUN=8
MAX_PARALLEL_SYMBOLS=3
# Retardo artificial (ms) de los proveedores mock (latencia simulada de LLM y datos)
DEMO_DELAY_MS=600
# Retardo (ms) por cada mensaje entre agentes; la UI permite cambiarlo por ejecución (0-5000)
MESSAGE_DELAY_MS=800
INITIAL_HISTORY_DAYS=130
EXTENDED_HISTORY_DAYS=365

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Modo un solo proceso ----------------------------------------------------
# Carpeta del frontend estático (npm run build:static). Si existe, se sirve en "/".
# Por defecto: ../frontend/out
# FRONTEND_DIST=

# ---- Modo de los agentes ------------------------------------------------------
# llm   → el modelo razona con herramientas; las reglas vigilan (guardarraíles)
# rules → las reglas deciden; el LLM solo redacta
AGENT_MODE=llm
# Turnos máximos del modelo por agente y tarea en modo llm
AGENT_MAX_STEPS=8
# Carpeta de persistencia de ejecuciones (JSON); vacío = solo memoria
# RUNS_DIR=

# =============================================================================
# Orquestador de revisión de requerimientos (paquete `orq/`)
# =============================================================================

# ---- Proveedor de IA ----------------------------------------------------------
# mock (por defecto) | anthropic | openrouter | perfil (cada agente el suyo)
AI_PROVIDER=mock
# AI_TIMEOUT_S=120
# AI_RETRY_ATTEMPTS=3
# AI_MAX_ATTEMPTS=2
# AI_MAX_OUTPUT_TOKENS=16000

# ---- Techo de gasto por ejecución (0 = sin límite) ----------------------------
# RUN_MAX_TOKENS=2000000
# RUN_MAX_COST_USD=5

# ---- Persistencia -------------------------------------------------------------
# Vacío = memoria (se pierde al reiniciar). Con valor, PostgreSQL.
# DATABASE_URL=postgresql://orq:orq@localhost:55432/orq
#
# Clave Fernet del cifrado en reposo. OBLIGATORIA si hay DATABASE_URL: sin ella el
# servicio no arranca, porque la base guarda contenido que puede incluir PHI.
# Generarla con:
#   python -c "from orq.infrastructure.db import Cipher; print(Cipher.generate_key())"
# Guardarla fuera del repositorio y fuera de la base (en producción, un KMS).
# DB_ENCRYPTION_KEY=
#
# Días de retención por defecto de un requerimiento (0 = sin caducidad automática).
# RETENTION_DAYS=0

# ---- Repositorios git (ORQ-22) ------------------------------------------------
# Credenciales por host para clonar repositorios privados.
#
# Lo normal es guardarlas en la **bóveda** (Gobierno -> Bóveda de secretos, ORQ-18): van cifradas
# en la base, se pueden rotar y revocar, y cada uso queda auditado. Esta variable es solo un
# respaldo para una máquina de desarrollo; si el host está en la bóveda, manda la bóveda.
# Formato: host=token  o  host=usuario:token, separados por comas.
#   GIT_TOKENS=github.com=ghp_xxx,dev.azure.com=usuario:pat_yyy
# GIT_TOKENS=
#
# Clonado parcial: mucho más rápido en repositorios grandes. Vacío = clonar entero.
# Si el servidor no lo admite, se reintenta entero automáticamente.
# GIT_CLONE_FILTER=blob:none
#
# Topes para que un repositorio enorme no se lleve la ejecución por delante.
# GIT_MAX_FILES=300
# GIT_MAX_DIFF_BYTES=4000000
# GIT_CLONE_TIMEOUT_S=300

# ---- Identidad y sesión (ORQ-5) -----------------------------------------------
# Cuenta inicial. Se crea la PRIMERA vez que arranca el servicio y solo si no hay
# ninguna cuenta: si ya las hay, estas variables no pueden resucitar un administrador.
# La contraseña acaba en el historial del terminal, así que la cuenta nace marcada
# para cambiarla al entrar.
# ADMIN_EMAIL=admin@tuempresa.com
# ADMIN_PASSWORD=
#
# Tope duro de una sesión y corte por inactividad (HIPAA 164.312(a)(2)(iii)).
# SESSION_MAX_AGE_MINUTES=720
# SESSION_IDLE_MINUTES=30
#
# `Secure` en la cookie de sesión: solo viaja por HTTPS. Déjalo apagado en desarrollo
# (que sirve por HTTP) y enciéndelo al desplegar con TLS (ORQ-31).
# SESSION_COOKIE_SECURE=0
#
# Bloqueo de una cuenta tras varios intentos fallidos seguidos.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
